From 651a9240f4e8672cf35b9eae5c4d7302c3d3fce0 Mon Sep 17 00:00:00 2001
From: Matheus Siqueira <hellomatheusdev@gmail.com>
Date: Sat, 24 Oct 2026 23:52:07 -0300
Subject: [PATCH 4/5] fix(frontend): format compact money without Intl compact
 notation

---
 frontend/lib/format.ts       | 16 +++++++++++++---
 frontend/tests/brand.test.ts |  6 ++++++
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/frontend/lib/format.ts b/frontend/lib/format.ts
index 70b44f2..257b55c 100644
--- a/frontend/lib/format.ts
+++ b/frontend/lib/format.ts
@@ -8,7 +8,8 @@ const dayMonth = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-di
 
 /** Manual de marca v1.0: dado ausente e escrito por extenso, nunca zero inventado. */
 export const MISSING = 'Não informado';
-const brlCompact = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', notation: 'compact', maximumFractionDigits: 1 });
+const oneDecimal = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });
+const COMPACT_SCALES: readonly (readonly [number, string])[] = [[1, ''], [1e3, ' mil'], [1e6, ' mi'], [1e9, ' bi']];
 const monthName = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'America/Fortaleza' });
 const percent = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
 
@@ -22,9 +23,18 @@ export function money(value: Money | number | null | undefined): string {
   return plain(brl.format(typeof value === 'number' ? value : value.amount));
 }
 
-/** Valor curto para rotulo de grafico: "R$ 47 mil", "R$ 1,2 mi". */
+/**
+ * Valor curto para rotulo de grafico: "R$ 47 mil", "R$ 1,2 mi". Escala e sufixo sao calculados aqui, e nao pela
+ * notacao compacta do Intl, cujo resultado muda com a versao dos dados de localidade do Node ("R$ 47,0 mil").
+ */
 export function compactMoney(value: Money | number): string {
-  return plain(brlCompact.format(typeof value === 'number' ? value : value.amount));
+  const amount = typeof value === 'number' ? value : value.amount;
+  const abs = Math.abs(amount);
+  let index = 0;
+  while (index < COMPACT_SCALES.length - 1 && Math.round((abs / COMPACT_SCALES[index]![0]) * 10) / 10 >= 1000) index++;
+  const [size, suffix] = COMPACT_SCALES[index]!;
+  const scaled = Math.round((abs / size) * 10) / 10;
+  return `${amount < 0 && scaled > 0 ? '-' : ''}R$ ${plain(oneDecimal.format(scaled))}${suffix}`;
 }
 
 /** Mes de referencia (YYYY-MM) por extenso: "outubro de 2026". */
diff --git a/frontend/tests/brand.test.ts b/frontend/tests/brand.test.ts
index 36121c0..c4a9b09 100644
--- a/frontend/tests/brand.test.ts
+++ b/frontend/tests/brand.test.ts
@@ -59,6 +59,12 @@ test('[CT-WEB-124] formatos do manual: hora 14h30, periodo, ausente e valor curt
   assert.equal(MISSING, 'Não informado');
   assert.equal(money(undefined), MISSING);
   assert.equal(compactMoney(47_000), 'R$ 47 mil');
+  assert.equal(compactMoney({ amount: 1_234_567, currency: 'BRL' }), 'R$ 1,2 mi');
+  assert.equal(compactMoney(999_960), 'R$ 1 mi');
+  assert.equal(compactMoney(12_350), 'R$ 12,4 mil');
+  assert.equal(compactMoney(950), 'R$ 950');
+  assert.equal(compactMoney(0), 'R$ 0');
+  assert.equal(compactMoney(-47_000), '-R$ 47 mil');
   assert.equal(money(1234.5), 'R$ 1.234,50');
   assert.equal(initials('Allan Paula Lima'), 'AL');
   assert.equal(initials('marta'), 'M');

From 7de897afe071cb6947e5a7edf76daeda5e1b4097 Mon Sep 17 00:00:00 2001
