From 754dc150cda54c1890f1a2ac4d5500335dc4df36 Mon Sep 17 00:00:00 2001
From: Matheus Siqueira <hellomatheusdev@gmail.com>
Date: Sat, 24 Oct 2026 23:52:07 -0300
Subject: [PATCH 2/5] fix(frontend): add security headers to pages

---
 frontend/next.config.mjs                | 14 ++++++++++++++
 frontend/tests/security-headers.test.ts | 19 +++++++++++++++++++
 2 files changed, 33 insertions(+)
 create mode 100644 frontend/tests/security-headers.test.ts

diff --git a/frontend/next.config.mjs b/frontend/next.config.mjs
index 4b68d17..4dca49a 100644
--- a/frontend/next.config.mjs
+++ b/frontend/next.config.mjs
@@ -2,8 +2,22 @@ const backend = new URL(process.env.BACKEND_ORIGIN ?? 'http://127.0.0.1:8080');
 if (!['http:', 'https:'].includes(backend.protocol) || backend.username || backend.password || backend.pathname !== '/') {
   throw new Error('BACKEND_ORIGIN must be an HTTP(S) origin without credentials or path.');
 }
+
+// Cabecalhos das paginas. A CSP limita enquadramento, base, formularios e plugins sem restringir scripts e
+// estilos, que o App Router injeta em linha; as respostas da API ja trazem os proprios cabecalhos.
+export const PAGE_SECURITY_HEADERS = [
+  { key: 'Content-Security-Policy', value: "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
+  { key: 'X-Frame-Options', value: 'DENY' },
+  { key: 'X-Content-Type-Options', value: 'nosniff' },
+  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },
+  { key: 'Permissions-Policy', value: 'camera=(), microphone=(), geolocation=(), payment=()' },
+];
+
 export default {
   poweredByHeader: false,
+  async headers() {
+    return [{ source: '/:path((?!api/backend/).*)', headers: PAGE_SECURITY_HEADERS }];
+  },
   async rewrites() {
     return [{ source: '/api/backend/:path*', destination: `${backend.origin}/:path*` }];
   },
diff --git a/frontend/tests/security-headers.test.ts b/frontend/tests/security-headers.test.ts
new file mode 100644
index 0000000..d420c75
--- /dev/null
+++ b/frontend/tests/security-headers.test.ts
@@ -0,0 +1,19 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+const configUrl = new URL('../next.config.mjs', import.meta.url).href;
+
+test('paginas recebem CSP contra enquadramento e cabecalhos de seguranca; rotas da API ficam de fora', async () => {
+  const config = (await import(configUrl)).default;
+  const rules: Array<{ source: string; headers: Array<{ key: string; value: string }> }> = await config.headers();
+  assert.equal(rules.length, 1);
+  const [rule] = rules;
+  const headers = new Map(rule!.headers.map(header => [header.key, header.value]));
+  assert.match(headers.get('Content-Security-Policy') ?? '', /frame-ancestors 'none'/);
+  assert.match(headers.get('Content-Security-Policy') ?? '', /object-src 'none'/);
+  assert.equal(headers.get('X-Frame-Options'), 'DENY');
+  assert.equal(headers.get('X-Content-Type-Options'), 'nosniff');
+  assert.equal(headers.get('Referrer-Policy'), 'strict-origin-when-cross-origin');
+  assert.ok(headers.has('Permissions-Policy'));
+  assert.equal(rule!.source, '/:path((?!api/backend/).*)');
+});

